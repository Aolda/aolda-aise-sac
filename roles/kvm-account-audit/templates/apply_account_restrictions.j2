#!/bin/bash
# Managed by Ansible. Reviewed lock targets only; password lock plus nologin.
set -euo pipefail
[ "$EUID" -eq 0 ] || { echo "root required" >&2; exit 1; }
[ "$#" -eq 1 ] || { echo "Usage: $0 username" >&2; exit 1; }
username="$1"
allowed=({{ kvm_lock_target_accounts | default([]) | map('quote') | join(' ') }})
matched=false
for candidate in "${allowed[@]}"; do
    if [ "$candidate" = "$username" ]; then matched=true; fi
done
$matched || { echo "Not an approved lock target" >&2; exit 1; }
getent passwd "$username" >/dev/null
if [ "$(passwd -S "$username" | awk '{print $2}')" != L ]; then usermod -L "$username"; fi
if [ "$(getent passwd "$username" | cut -d: -f7)" != {{ kvm_nologin_shell | quote }} ]; then
    usermod -s {{ kvm_nologin_shell | quote }} "$username"
fi
